{
  "name": "cacti/plugin-maint",
  "description": "Cacti maintenance window plugin.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.93",
    "phpstan/phpstan": "^1.11",
    "overtrue/phplint": "^9.2"
  },
  "scripts": {
    "lint": "../../vendor/bin/phplint -c ../../.phplint.yml plugins/maint",
    "phpcsfixer": "../../vendor/bin/php-cs-fixer fix --dry-run --diff --config=../../.php-cs-fixer.php plugins/maint",
    "phpstan": "../../vendor/bin/phpstan analyse -c ../../phpstan.neon plugins/maint"
  }
}
