msgid "Webseer(s)"
msgstr "WebSeer(и)"

#: maint.php
#, php-format
msgid "Click 'Continue' to Associate the Webseer(s) below with the Maintenance Schedule '<b>%s</b>'."
msgstr "Щракнете върху „Продължи“, за да свържете следните WebSeer проверки с графика за поддръжка „<b>%s</b>“."

#: maint.php
#, php-format
msgid "Click 'Continue' to Disassociate the Webseer(s) below from the Maintenance Schedule '<b>%s</b>'."
