#: maint.php
#, php-format
msgid "Click 'Continue' to Associate the following Device(s) with the Maintenance Schedule '<b>%s</b>'."
msgstr "Щракнете върху „Продължи“, за да свържете следните устройства с графика за поддръжка „<b>%s</b>“."

#: maint.php
msgid "Associate Maintenance Schedule(s)"
msgstr "Свързване на график(ци) за поддръжка"

#: maint.php
#, php-format
msgid "Click 'Continue' to Disassociate the following Device(s) with the Maintenance Schedule '<b>%s</b>'."
msgstr "Щракнете върху „Продължи“, за да премахнете връзката на следните устройства с графика за поддръжка „<b>%s</b>“."

